{
  "hosting": {
    "site": "REEMPLAZAR_POR_SITE_ID_INFRAESTRUCTURA",
    "public": "infraestructura",
    "ignore": [
      "firebase.infraestructura.template.json",
      "README.md",
      "firestore.rules.fragment.txt",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "same-origin" }
        ]
      }
    ]
  }
}
